# Copiá este archivo a `.env` y reemplazá cada valor. Los de ejemplo NO sirven: la API se niega a arrancar si
# JWT_SECRET o INGEST_API_KEY son cortos, repetitivos o parecen un valor de ejemplo.
# Para generar un secreto:  python -c "import secrets; print(secrets.token_hex(32))"

# ── Obligatorias ────────────────────────────────────────────────────────────────────────────────────────────────
JWT_SECRET=<generá-uno-de-64-caracteres>
INGEST_API_KEY=<generá-uno-de-64-caracteres>
UPSTASH_REDIS_URL=rediss://default:<password>@<hostname>:<port>
DATABASE_URL=postgresql://<usuario>:<password>@<host>:5432/<base>

# Administrador inicial: se crea solo si la tabla users está vacía. La contraseña necesita 12+ caracteres.
ADMIN_EMAIL=<tu-correo>
ADMIN_PASSWORD=<una-contraseña-larga-y-única>

# ── Recomendadas en producción ──────────────────────────────────────────────────────────────────────────────────
# Orígenes que pueden usar la API desde un navegador (separados por coma). También limita quién abre el WebSocket.
CORS_ORIGINS=http://localhost:3000
# Cuántos proxies de confianza hay delante de la API (Railway: 1). Con 0 los límites de ritmo cuentan por la IP del proxy.
TRUSTED_PROXY_COUNT=0
# Verificación del certificado de la base: bajá la CA de Supabase (Database > Settings > SSL Configuration) y usá
# DATABASE_SSL_MODE=verify-full con DATABASE_SSL_CA (el texto PEM o la ruta al archivo). Por defecto solo cifra.
# (`disable` apaga el TLS: solo para una base local de desarrollo.)
DATABASE_SSL_MODE=require
# DATABASE_SSL_CA=

# ── Ajustes opcionales (valores por defecto) ────────────────────────────────────────────────────────────────────
# MAX_REQUEST_BYTES=2000000     # tamaño máximo del cuerpo de un pedido
# MAX_INGEST_LINES=1000         # líneas por pedido a /ingest
# MAX_WS_CONNECTIONS=50         # paneles conectados a la vez
# BCRYPT_ROUNDS=12              # costo del hash de contraseñas
# DEBUG=false                   # true habilita /docs y /openapi.json (solo desarrollo)
PORT=8000
